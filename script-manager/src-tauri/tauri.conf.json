{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scripts Manager",
  "version": "0.1.0",
  "identifier": "com.wassbe.script-manager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Scripts Manager",
        "width": 800,
        "height": 600,
        "visible": false,
        "skipTaskbar": true,
        "decorations": false,
        "resizable": false,
        "dragDropEnabled": true
      },
      {
        "label": "traymenu",
        "title": "Scripts Manager Menu",
        "width": 230,
        "height": 195,
        "visible": false,
        "skipTaskbar": true,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "transparent": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
